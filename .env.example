# Environment variables the backend reads. Set them in your shell or IDE run configuration.
# Spring Boot does not load this file automatically.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Ecomerce
DB_USER=postgres
DB_PASSWORD=

# Signs sign-in tokens. If empty, a random key is used and sign-ins end on restart.
JWT_SECRET=

# Stripe secret key (sk_test_...). Without it the store works but checkout is unavailable.
STRIPE_SECRET_KEY=

# Public URL of the site. Render's URL is detected automatically.
APP_BASE_URL=http://localhost:4200

# Optional email. Render's free plan blocks SMTP, so keep this off there.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
